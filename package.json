{
  "name": "kraqel",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first authoring studio with an open, portable project format.",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "build:installer:test:windows": "pnpm --filter @kraqel/desktop tauri build --debug --bundles nsis --config src-tauri/tauri.installer-test.conf.json",
    "build:tauri:smoke:windows": "pnpm --filter @kraqel/desktop tauri build --debug --no-bundle --config src-tauri/tauri.smoke.conf.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && cargo test --workspace",
    "dev": "pnpm --filter @kraqel/desktop dev",
    "desktop": "pnpm --filter @kraqel/desktop tauri dev",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "lint": "eslint . && cargo clippy --workspace --all-targets -- -D warnings",
    "test:tauri:windows": "node scripts/windows-tauri-smoke.mjs",
    "test:installer:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-installer-smoke.ps1",
    "test:e2e": "pnpm --filter @kraqel/desktop test:e2e",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
