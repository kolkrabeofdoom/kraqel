{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KRAQEL Installer-Test",
  "identifier": "org.kraqel.desktop.installer-test",
  "app": {
    "appDirectoriesOverride": "$TEMP/kraqel-tauri-smoke-installer",
    "windows": [
      {
        "title": "KRAQEL Installer-Test",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"]
      }
    }
  }
}
