401 DIALOGEX 0, 0, 310, 188
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "KRAQEL – Projektübersicht"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Lokale Projekte", 101, 10, 9, 290, 12
    LISTBOX 102, 10, 23, 290, 80, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
