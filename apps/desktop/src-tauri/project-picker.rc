#pragma code_page(65001)
#include <winuser.h>
401 DIALOGEX 0, 0, 372, 188
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "KRAQEL – Projektübersicht"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Lokale Projekte", 101, 10, 9, 352, 12
    LISTBOX 102, 10, 23, 352, 80, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT "Manuskript nativ lesen öffnet die lokale Kapitel- und Szenenauswahl. Studio und Projektverwaltung starten WebView2 und können Netzwerkverbindungen herstellen.", -1, 10, 112, 352, 34
    DEFPUSHBUTTON "Im &Studio öffnen", IDOK, 10, 160, 72, 17
    PUSHBUTTON "Manuskript &nativ lesen", 104, 87, 160, 96, 17
    PUSHBUTTON "Projekt&verwaltung öffnen", 103, 188, 160, 104, 17
    PUSHBUTTON "&Schließen", IDCANCEL, 298, 160, 64, 17
END

402 DIALOGEX 0, 0, 310, 157
