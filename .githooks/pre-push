#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"

# Tests create their own Git repositories; do not pass this checkout's Git context to them.
unset $(git rev-parse --local-env-vars)

if ! command -v node >/dev/null 2>&1; then
  echo "KRAQEL: Node.js fehlt. Bitte die Entwicklungswerkzeuge installieren; Push abgebrochen." >&2
  exit 127
fi

echo "KRAQEL: Prüfe Formatierung, Lint, Typen und Tests vor dem Push ..." >&2
exec node scripts/pre-push.mjs </dev/null
